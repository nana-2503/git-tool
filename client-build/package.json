{
  "name": "dsh-github-push-build",
  "private": true,
  "type": "module",
  "description": "Build workspace for @local/dsh-github-push's Client half: fetches the official shadcn components, compiles their Tailwind recipes, and bundles the Client half into a single ModuleLoader artifact.",
  "scripts": {
    "vendor": "node scripts/vendor-shadcn.mjs",
    "css": "tailwindcss -i src/styles.css -o dist/shadcn.css --minify",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run vendor && npm run css && npm run bundle",
    "browser": "node tests/browser/run.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "~18.3.1",
    "esbuild": "0.28.2",
    "jsdom": "^27.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "playwright": "1.49.1"
  }
}
